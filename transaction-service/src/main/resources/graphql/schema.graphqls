type Query {
    transactions(accountId: ID): [BankTransaction!]!
}

type Mutation {
    createTransaction(input: CreateTransactionInput!): BankTransaction
    transfer(input: TransferInput!): TransferResult
}

type BankTransaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
    createdAt: String!
    direction: String!
    transferId: ID
}

input CreateTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    sourceAccountId: ID!
    destinationAccountId: ID!
    amount: Float!
    currency: String!
}

type TransferResult {
    transferId: ID!
    debit: BankTransaction!
    credit: BankTransaction!
}
