type Query {
    transactions(accountId: ID): [BankTransaction!]!
}

type Mutation {
    createTransaction(input: CreateTransactionInput!): BankTransaction
}

type BankTransaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
    createdAt: String!
}

input CreateTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}
